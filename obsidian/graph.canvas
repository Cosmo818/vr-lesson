    {
      "id": "n_server_netapi_rationale_31",
      "type": "file",
      "file": "\u00ab\u0424\u0430\u043c\u0438\u043b\u0438\u044f \u0418\u043c\u044f \u041e\u0442\u0447\u0435\u0441\u0442\u0432\u043e\u00bb \u2192 \u00ab\u0418\u043c\u044f \u0424.\u00bb; \u043e\u0434\u043d\u043e \u0441\u043b\u043e\u0432\u043e \u2014 \u043a\u0430\u043a \u0435\u0441\u0442\u044c; \u2264 24 \u0437\u043d\u0430\u043a\u0430. \u041f\u043e\u043b\u043d\u043e\u0435\u2026.md",
      "x": 13500,
      "y": 1500,
      "width": 180,
      "height": 60
    },
    {
      "id": "n_server_netapi_rationale_70",
