    },
    {
      "id": "n_server_app_rationale_361",
      "type": "file",
      "file": "\u0418\u043c\u0435\u043d\u0430 \u0438\u0437\u043c\u0435\u043d\u0438\u0432\u0448\u0438\u0445\u0441\u044f \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a (\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f \u043d\u0435 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u044e\u0442\u0441\u044f \u0441\u0440\u0435\u0434\u0438 \u043d\u0438\u0445 \u0431\u044b\u0432\u0430\u044e\u0442 \u0445\u044d\u0448 \u0438\u2026.md",
      "x": 10820,
