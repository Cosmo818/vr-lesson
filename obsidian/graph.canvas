    {
      "id": "n_tests_fixtures_server_v3_rationale_153",
      "type": "file",
      "file": "v2 - v3 \u043a\u043e\u043b\u043e\u043d\u043a\u0438 schoolyearstatus (\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0439 \u0438\u043d\u0434\u0435\u043a\u0441, \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u043f\u0440\u0430\u0432\u0434\u044b \u2014\u2026.md",
      "x": 220,
      "y": 2300,
      "width": 180,
      "height": 60
    },
    {
      "id": "n_tests_fixtures_server_v3_rationale_188",
      "type": "file",
      "file": "\u0412\u043d\u043e\u0441\u0438\u0442 \u043f\u0440\u0438\u0441\u043b\u0430\u043d\u043d\u043e\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0432 \u0431\u0430\u0437\u0443 \u043f\u043e \u0442\u0435\u043c \u0436\u0435 \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c, \u0447\u0442\u043e \u0438 jsstore.js\u2026.md",
      "x": 420,
      "y": 2300,
      "width": 180,
      "height": 60
    },
    {
      "id": "n_tests_fixtures_server_v3_rationale_2",
      "type": "file",
      "file": "\u0417\u0430\u043c\u043e\u0440\u043e\u0436\u0435\u043d\u043d\u0430\u044f \u043a\u043e\u043f\u0438\u044f serverapp.py \u0441\u0445\u0435\u043c\u044b v3 (\u0434\u043e \u0448\u0430\u0433\u0430 1 \u043f\u043b\u0430\u043d\u0430 \u0443\u0447\u0451\u0442\u043e\u043a, 22.10.2026).\u2026.md",
      "x": 620,
      "y": 2300,
      "width": 180,
      "height": 60
    },
    {
      "id": "n_tests_fixtures_server_v3_rationale_137",
      "type": "file",
      "file": "\u041a\u043e\u043f\u0438\u044f \u0431\u0430\u0437\u044b \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043c\u0438 SQLite \u0440\u044f\u0434\u043e\u043c \u0441 \u0431\u0430\u0437\u043e\u0439; \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u043a\u043e\u043f\u0438\u0438 \u043d\u0435 \u0442\u0440\u043e\u0433\u0430\u0435\u043c..md",
      "x": 820,
      "y": 2300,
      "width": 180,
      "height": 60
    },
    {
      "id": "n_tests_fixtures_server_v3_rationale_82",
      "type": "file",
      "file": "\u041d\u0430\u0447\u0430\u043b\u043e \u0443\u0447\u0435\u0431\u043d\u043e\u0433\u043e \u0433\u043e\u0434\u0430 \u043f\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u0438 \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f (\u043c\u0441, UTC) \u0430\u0432\u0433\u0443\u0441\u0442 \u0438 \u043f\u043e\u0437\u0436\u0435 \u2014 \u044d\u0442\u043e\u0442 \u0433\u043e\u0434,\u2026.md",
