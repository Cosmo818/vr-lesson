    },
    {
      "id": "n_server_app_rationale_961",
      "type": "file",
      "file": "\u0415\u0441\u0442\u044c \u043b\u0438 \u043a\u0443\u0434\u0430 \u0432\u044b\u0434\u0430\u0432\u0430\u0442\u044c \u0440\u043e\u043b\u044c \u0434\u043b\u044f \u0430\u0434\u043c\u0438\u043d\u0438\u0441\u0442\u0440\u0430\u0442\u043e\u0440\u0430 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u2014 \u0445\u043e\u0442\u044f \u0431\u044b \u043e\u0434\u043d\u0430 \u0448\u043a\u043e\u043b\u0430 \u0432\u2026.md",
