    {
      "id": "n_tests_scope_rationale_1",
      "type": "file",
      "file": "\u0428\u0430\u0433 6 PLAN.md \u043f\u0440\u0430\u0432\u0430 \u043f\u043e \u043f\u043e\u0434\u0434\u0435\u0440\u0435\u0432\u0443 \u0432 \u0441\u0438\u043d\u0445\u0440\u043e\u043d\u0438\u0437\u0430\u0446\u0438\u0438 \u0438 \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0435. \u0414\u0432\u0435 \u0448\u043a\u043e\u043b\u044b,\u2026.md",
      "x": 6140,
      "y": 2640,
      "width": 180,
      "height": 60
