    {
      "id": "n_server_einrank_rationale_394",
      "type": "file",
      "file": "\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u043a\u0430\u0431\u0438\u043d\u0435\u0442\u0430 ein.void {pk, pid, seed} \u2014 \u0430\u043d\u043d\u0443\u043b\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0440\u0435\u0448\u0435\u043d\u0438\u0435(\u044f);\u2026.md",
      "x": 2280,
      "y": 1500,
      "width": 180,
      "height": 60
    },
    {
      "id": "n_server_einrank_rationale_285",
      "type": "file",
      "file": "\u041c\u0435\u0441\u0442\u043e \u0437\u0440\u0438\u0442\u0435\u043b\u044f \u0431\u0435\u0437 \u043e\u043a\u043d\u0430 \u043e\u0434\u043d\u0430 \u0441\u0442\u0440\u043e\u043a\u0430 \u0435\u0433\u043e \u0441\u0432\u043e\u0434\u043a\u0438 + count() \u0442\u0435\u0445, \u043a\u0442\u043e \u0432\u044b\u0448\u0435 (\u0442\u043e\u0442 \u0436\u0435\u2026.md",
      "x": 2480,
      "y": 1500,
      "width": 180,
      "height": 60
    },
    {
      "id": "n_server_einrank_rationale_108",
      "type": "file",
      "file": "\u041d\u043e\u043c\u0435\u0440 \u0433\u043e\u043b\u043e\u0432\u043e\u043b\u043e\u043c\u043a\u0438 \u0438\u0433\u0440\u043e\u043a\u0443 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0439, \u043d\u0435 \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u044e\u0449\u0438\u0439 \u0441 \u0443\u0436\u0435 \u0432\u044b\u0434\u0430\u043d\u043d\u044b\u043c \u0438\u043b\u0438 \u0440\u0435\u0448\u0451\u043d\u043d\u044b\u043c\u2026.md",
      "x": 2680,
      "y": 1500,
      "width": 180,
      "height": 60
    },
    {
      "id": "n_server_einrank_rationale_277",
      "type": "file",
      "file": "\u041e\u043a\u043d\u043e ROW_NUMBER \u043f\u043e \u0441\u0440\u0435\u0437\u0443 \u2014 \u0442\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0441\u043f\u0438\u0441\u043a\u0430 (\u043e\u0442\u0432\u0435\u0442 \u043a\u044d\u0448\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043d\u0430 60\u2026.md",
      "x": 2880,
      "y": 1500,
      "width": 180,
      "height": 60
    },
    {
      "id": "n_server_einrank_rationale_132",
      "type": "file",
      "file": "\u041f\u0435\u0440\u0435\u0441\u0447\u0451\u0442 \u0441\u0442\u0440\u043e\u043a\u0438 ein_stats \u0438\u0433\u0440\u043e\u043a\u0430 \u043f\u043e \u0437\u0430\u0447\u0451\u0442\u043d\u044b\u043c \u0440\u0435\u0448\u0435\u043d\u0438\u044f\u043c (helped=0, void=0); \u0448\u043a\u043e\u043b\u0430\u2026.md",
      "x": 3080,
      "y": 1500,
      "width": 180,
      "height": 60
    },
    {
      "id": "n_server_einrank_rationale_344",
      "type": "file",
      "file": "\u0420\u0435\u0433\u0438\u043e\u043d\u044b \u2192 \u0440\u0430\u0439\u043e\u043d\u044b \u2192 \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u0448\u043a\u043e\u043b\u044b (\u0434\u043b\u044f \u0444\u0438\u043b\u044c\u0442\u0440\u0430 \u0443\u0447\u0438\u0442\u0435\u043b\u044f)..md",
