      "height": 60
    },
    {
      "id": "n_server_einrank_rationale_196",
      "type": "file",
      "file": "\u0421\u0431\u0440\u043e\u0441 \u043e\u0442\u0432\u0435\u0442\u043e\u0432 top, \u0432 \u0441\u0440\u0435\u0437 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0432\u0445\u043e\u0434\u0438\u0442 \u0448\u043a\u043e\u043b\u0430 (\u0441\u0430\u043c\u0430 \u0448\u043a\u043e\u043b\u0430, \u0435\u0451 \u0440\u0430\u0439\u043e\u043d, \u0435\u0451\u2026.md",
