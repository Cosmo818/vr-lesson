    },
    {
      "id": "n_server_app_rationale_195",
      "type": "file",
      "file": "\u041a\u043e\u043f\u0438\u044f \u0431\u0430\u0437\u044b \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430\u043c\u0438 SQLite \u0440\u044f\u0434\u043e\u043c \u0441 \u0431\u0430\u0437\u043e\u0439; \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u043a\u043e\u043f\u0438\u0438 \u043d\u0435 \u0442\u0440\u043e\u0433\u0430\u0435\u043c..md",
