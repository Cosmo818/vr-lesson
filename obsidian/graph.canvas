    {
      "id": "n_server_app_rationale_769",
      "type": "file",
      "file": "\u041a\u043b\u044e\u0447 \u0448\u043b\u0435\u043c\u0430 \u0448\u043a\u043e\u043b\u044b (\u0432\u044b\u0434\u0430\u043d \u043f\u043e \u043a\u043e\u0434\u0443 \u043f\u0440\u0438\u0432\u044f\u0437\u043a\u0438) \u0438\u0449\u0435\u043c \u043f\u043e sha256, \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e\u2026.md",
